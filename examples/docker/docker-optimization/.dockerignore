# =============================================================================
# .dockerignore — Keep the build context small and secure
# =============================================================================
# Docker sends the entire build context to the daemon before building.
# Without a .dockerignore, a project with a 500 MB node_modules and a
# 200 MB .git directory sends 700 MB over the socket on every build.
#
# Rules:
#   1. Exclude everything that isn't needed for the build
#   2. Never include secrets (.env, credentials, keys)
#   3. Never include version control history (.git)
#   4. Exclude OS and editor artifacts
#
# Impact on build speed:
#   Without .dockerignore: "Sending build context" takes 5-30 seconds
#   With .dockerignore:    "Sending build context" takes <1 second
# =============================================================================

# ---------------------------------------------------------------------------
# Dependencies — installed inside the container via npm ci
# ---------------------------------------------------------------------------
node_modules

# ---------------------------------------------------------------------------
# Build output — generated inside the container via tsc
# ---------------------------------------------------------------------------
dist
build
out

# ---------------------------------------------------------------------------
# Version control — not needed for building, adds 50-500 MB
# ---------------------------------------------------------------------------
.git
.gitignore

# ---------------------------------------------------------------------------
# Secrets — NEVER include these in Docker images
# ---------------------------------------------------------------------------
# Even if you delete them in a later layer, they're recoverable from
# the image history (docker history --no-trunc <image>).
# Use Docker secrets, environment variables, or a vault instead.
.env
.env.*
*.pem
*.key
credentials.json
service-account.json

# ---------------------------------------------------------------------------
# Development and CI files — not needed in production
# ---------------------------------------------------------------------------
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Docker files — prevent recursive context issues
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore

# Documentation
README.md
CHANGELOG.md
LICENSE
docs/

# Tests — not needed in production image
__tests__
*.test.ts
*.test.js
*.spec.ts
*.spec.js
jest.config.*
vitest.config.*
coverage
.nyc_output

# Linting and formatting config
.eslintrc*
.prettierrc*
.editorconfig
biome.json

# CI/CD configuration
.github
.gitlab-ci.yml
.circleci
Jenkinsfile

# TypeScript config is needed for build stage, but tsconfig is COPYed
# explicitly — this prevents other config files from leaking in.
# Note: DO NOT add tsconfig.json here — it's required by the build stage.

# Miscellaneous
*.log
npm-debug.log*
yarn-debug.log*
.npm
.yarn
tmp
temp
