# =============================================================================
# Environment Variables — Copy to .env and customize
# =============================================================================
# cp .env.example .env
#
# Docker Compose reads .env automatically from the same directory as
# docker-compose.yml. Values here override the defaults in the compose file.
# =============================================================================

# --- API ---
API_PORT=3000
LOG_LEVEL=debug

# --- PostgreSQL ---
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpass
POSTGRES_DB=devdb
# Host port for direct access (e.g., psql, pgAdmin). The container always
# listens on 5432 internally.
POSTGRES_PORT=5433

# --- Redis ---
# Host port for direct access (e.g., redis-cli).
REDIS_PORT=6380

# --- Adminer ---
ADMINER_PORT=8080
